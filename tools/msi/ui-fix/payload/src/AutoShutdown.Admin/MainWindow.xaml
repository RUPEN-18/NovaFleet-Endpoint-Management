<?xml version='1.0' encoding='utf-8'?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="AutoShutdown.Admin.MainWindow" Title="L&amp;T Admin" Width="1280" Height="820" MinWidth="900" MinHeight="620" WindowState="Maximized" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="SmallLabel" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="CenteredGridCheckBox" TargetType="CheckBox">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Focusable" Value="False" />
        </Style>
        <Style x:Key="CenteredGridCheckBoxEdit" TargetType="CheckBox">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="IsHitTestVisible" Value="True" />
            <Setter Property="Focusable" Value="True" />
        </Style>
        <Style x:Key="CenteredCheckCell" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="0" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="90" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.RowSpan="2" Background="White" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="18,18,12,16">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="Assets/lt-logo.png" Width="38" Height="38" />
                        <TextBlock Text="L&amp;T Admin" FontSize="21" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="PC management" Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="20">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Ellipse x:Name="SidebarHealthDot" Width="7" Height="7" HorizontalAlignment="Left" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="SidebarHealthText" Text="Connecting" />
                    </StackPanel>
                    <TextBlock x:Name="SidebarEndpointText" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                    <TextBlock x:Name="AdminIdleStatusText" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,10,0,12" />
                    <Button Content="Logout" Style="{StaticResource GlowButton}" Click="Logout_Click" />
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Button x:Name="NavDashboard" Content="Dashboard" Style="{StaticResource ActiveNavButton}" Click="NavDashboard_Click" />
                        <Button x:Name="NavClients" Content="Client PCs" Style="{StaticResource NavButton}" Click="NavClients_Click" />
                        <Button x:Name="NavDeployments" Content="Software Installation" Style="{StaticResource NavButton}" Click="NavDeployments_Click" />
                        <Button x:Name="NavAutomation" Content="Control Panel" Style="{StaticResource NavButton}" Click="NavAutomation_Click" />
                        <Button x:Name="NavAccounts" Content="Admin Management" Style="{StaticResource NavButton}" Click="NavAccounts_Click" />
                        <Button x:Name="NavLogs" Content="Activity Logs" Style="{StaticResource NavButton}" Click="NavLogs_Click" />
                        <Button x:Name="NavSettings" Content="Settings" Style="{StaticResource NavButton}" Click="NavSettings_Click" />
                        <Expander Header="Messages &amp; scheduling" Margin="18,14">
                            <StackPanel>
                                <Button x:Name="NavMessaging" Content="Messages &amp; images" Style="{StaticResource NavButton}" Click="NavMessaging_Click" />
                                <Button x:Name="NavGroups" Content="Groups" Style="{StaticResource NavButton}" Click="NavGroups_Click" />
                                <Button x:Name="NavSchedules" Content="Schedules" Style="{StaticResource NavButton}" Click="NavSchedules_Click" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
        <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1">
            <Grid Margin="26,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="PageTitleText" Text="Dashboard" FontSize="25" FontWeight="Bold" />
                    <TextBlock x:Name="PageSubtitleText" Text="Your connected PCs, at a glance." Style="{StaticResource Caption}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="AdminIdentityText" FontWeight="SemiBold" HorizontalAlignment="Right" MaxWidth="240" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                    <TextBlock x:Name="HeaderStatusText" Text="Ready" Style="{StaticResource Caption}" HorizontalAlignment="Right" Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>
        <ScrollViewer Grid.Column="1" Grid.Row="1" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled" x:Name="MainPageScrollViewer" CanContentScroll="False">
            <Grid Margin="24">
                <StackPanel x:Name="DashboardPage">
                    <Border CornerRadius="16" BorderBrush="#D7E8F8" BorderThickness="1" Padding="22,18" Margin="0,0,0,18">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#EAF4FE" Offset="0" />
                                <GradientStop Color="#F8FBFE" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock x:Name="DashboardWelcomeText" Text="Welcome back" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="Your PCs, at a glance." Foreground="#657C95" Margin="0,5,0,0" FontSize="13" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="White" BorderBrush="#DCE6F1" BorderThickness="1" CornerRadius="12" Padding="12,8" VerticalAlignment="Center">
                                <StackPanel>
                                    <TextBlock Text="Admin server" FontSize="11" Foreground="#657C95" />
                                    <TextBlock x:Name="DashboardServerStatus" Text="Connecting" FontWeight="SemiBold" FontSize="12" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                    <UniformGrid Columns="3" Margin="0,0,0,18">
                        <Border Background="White" BorderBrush="#DAE4EF" BorderThickness="1" CornerRadius="14" Padding="20,16" Margin="0,0,12,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Fill="#1764BD" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Total PCs" Foreground="#60758E" FontSize="13" FontWeight="SemiBold" />
                                </StackPanel>
                                <TextBlock x:Name="MetricKnown" Text="0" FontSize="32" FontWeight="SemiBold" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Background="White" BorderBrush="#DAE4EF" BorderThickness="1" CornerRadius="14" Padding="20,16" Margin="0,0,12,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Fill="#14805E" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Online" Foreground="#60758E" FontSize="13" FontWeight="SemiBold" />
                                </StackPanel>
                                <TextBlock x:Name="MetricOnline" Text="0" FontSize="32" FontWeight="SemiBold" Foreground="#14805E" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Background="White" BorderBrush="#DAE4EF" BorderThickness="1" CornerRadius="14" Padding="20,16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Fill="#8191A6" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Offline" Foreground="#60758E" FontSize="13" FontWeight="SemiBold" />
                                </StackPanel>
                                <TextBlock x:Name="MetricOffline" Text="0" FontSize="32" FontWeight="SemiBold" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                    <Border Background="White" BorderBrush="#DAE4EF" BorderThickness="1" CornerRadius="16" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Client PCs" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,5" />
                            <TextBlock Text="Client app connection status" Foreground="#60758E" FontSize="12" Margin="0,0,0,14" />
                            <DataGrid x:Name="DashboardClientsGrid" Height="130" IsReadOnly="True" RowHeight="40" CanUserResizeColumns="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="White">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Computer" Binding="{Binding Computer}" Width="2*" MinWidth="160">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                                <Setter Property="ToolTip" Value="{Binding Computer}" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTemplateColumn Header="Status" Width="140" MinWidth="105">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="7" Padding="10,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#F0F3F7" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ControlText}" Value="ONLINE">
                                                                    <Setter Property="Background" Value="#E8F7EF" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding ControlText}" FontSize="11" FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#697B91" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ControlText}" Value="ONLINE">
                                                                        <Setter Property="Foreground" Value="#14805E" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Last seen" Binding="{Binding ControlLastSeen}" Width="*" MinWidth="120">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                                <Setter Property="ToolTip" Value="{Binding ControlLastSeen}" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock x:Name="DashboardEmptyText" Text="Loading client PCs..." Foreground="#60758E" TextWrapping="Wrap" Margin="0,12,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel x:Name="ClientsPage" Visibility="Collapsed">
                    <Border Style="{StaticResource GlassCard}">
                        <StackPanel>
                            <TextBlock Text="Registered client PCs" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Installer service and Client app connections are shown separately. Offline rows show the last reported state." Style="{StaticResource Caption}" Margin="0,6" TextWrapping="Wrap" />
                            <DataGrid x:Name="ManagedDevicesGrid" Height="300" IsReadOnly="True" SelectionMode="Single" Margin="0,12,0,12" SelectionChanged="ManagedDevice_Selected" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" CanUserResizeColumns="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Client PC" Binding="{Binding Display}" Width="1.3*" IsReadOnly="True" MinWidth="150">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="ToolTip" Value="{Binding Display}" />
                                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Installer service" Binding="{Binding OnlineText}" Width="130" IsReadOnly="True" MinWidth="95">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="ToolTip" Value="{Binding OnlineText}" />
                                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Control app" Binding="{Binding ControlText}" Width="120" IsReadOnly="True" MinWidth="95">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="ToolTip" Value="{Binding ControlText}" />
                                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Monitoring" Binding="{Binding MonitoringText}" Width="115" MinWidth="95" IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Verified software" Binding="{Binding InstalledSoftware}" Width="1.2*" IsReadOnly="True" MinWidth="95">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="ToolTip" Value="{Binding InstalledSoftware}" />
                                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Device ID" Binding="{Binding Id}" Width="1.6*" IsReadOnly="True" MinWidth="95">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="ToolTip" Value="{Binding Id}" />
                                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Last seen" Binding="{Binding LastSeen}" Width="145" IsReadOnly="True" MinWidth="95">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="ToolTip" Value="{Binding LastSeen}" />
                                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <WrapPanel Margin="0,8">
                                <Button Content="Install software" Style="{StaticResource PrimaryButton}" Click="NavDeployments_Click" />
                                <ComboBox x:Name="ClientTargetCombo" Width="240" Margin="10,0" SelectionChanged="ClientTargetCombo_SelectionChanged" />
                                <Button Content="Pause" Style="{StaticResource GlowButton}" Click="PauseButton_Click" Margin="0,0,8,0" x:Name="PauseClientButton" />
                                <Button Content="Resume" Style="{StaticResource GlowButton}" Click="ResumeButton_Click" x:Name="ResumeClientButton" />
                                <Button Content="Shut down" Style="{StaticResource DangerButton}" Click="ShutdownButton_Click" Margin="8,0" x:Name="ShutdownClientButton" />
                                <Button Content="Cancel shutdown" Style="{StaticResource GlowButton}" Click="CancelShutdownButton_Click" x:Name="CancelClientShutdownButton" />
                            </WrapPanel>
                            <DataGrid x:Name="ClientsGrid" Visibility="Collapsed" SelectionChanged="ClientsGrid_SelectionChanged" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" CanUserResizeColumns="True" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel x:Name="DeploymentsPage" Visibility="Collapsed">
                    <Border x:Name="SoftwareInstallPanel" Style="{StaticResource GlassCard}">
                        <StackPanel>
                            <TextBlock Text="Install software" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Use the mouse wheel to scroll this page. Hold Ctrl while scrolling to browse a table, or drag its scrollbar." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,12" />
                            <TextBlock Text="1. Select client PCs" FontWeight="SemiBold" Margin="0,18,0,0" />
                            <WrapPanel Margin="0,10,0,6">
                                <Button x:Name="SelectOnlineTargetsButton" Content="Select available PCs" Click="SelectOnlineInstallTargets_Click" Style="{StaticResource GlowButton}" Margin="0,0,8,0" />
                                <Button x:Name="ClearInstallTargetsButton" Content="Clear PCs" Click="ClearInstallTargets_Click" Style="{StaticResource GlowButton}" />
                            </WrapPanel>
                            <TextBlock Text="Offline or busy PCs are not queued. Reconnect them and submit again." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <DataGrid x:Name="InstallTargetsGrid" Height="155" IsReadOnly="False" SelectionMode="Single" Margin="0,0,0,8" CanUserResizeColumns="True" VerticalScrollBarVisibility="Visible">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Select" Width="65" CellStyle="{StaticResource CenteredCheckCell}">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Enabled}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0" Padding="0" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Client PC" Binding="{Binding ComputerName}" Width="1.3*" MinWidth="100" IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                                <Setter Property="ToolTip" Value="{Binding ComputerName}" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Installer service" Binding="{Binding StatusText}" Width="130" MinWidth="100" IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                                <Setter Property="ToolTip" Value="{Binding StatusText}" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Service version" Binding="{Binding ServiceVersion}" Width="120" MinWidth="100" IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                                <Setter Property="ToolTip" Value="{Binding ServiceVersion}" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Latest result" Binding="{Binding LatestStatus}" Width="1.5*" MinWidth="100" IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                                <Setter Property="ToolTip" Value="{Binding LatestStatus}" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock x:Name="InstallSelectionText" Text="No PCs selected." Style="{StaticResource Caption}" Margin="0,0,0,12" />
                            <TextBlock Text="2. Choose a package" FontWeight="SemiBold" Margin="0,8" />
                            <WrapPanel>
                                <Grid Width="320" Margin="0,0,12,8">
                                    <ComboBox x:Name="ApprovedPackagesCombo" DisplayMemberPath="Name" SelectedValuePath="Id" Width="Auto" SelectionChanged="ApprovedPackage_Changed" Margin="0" />
                                    <TextBlock Text="Choose software..." Margin="14,0,36,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{StaticResource BrushMuted}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedItem, ElementName=ApprovedPackagesCombo}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <Button Content="Clear selection" Click="ClearSoftwareSelection_Click" Style="{StaticResource GlowButton}" Margin="0,0,12,8" />
                                <Button x:Name="ImportApplicationButton" Content="Approve installer — EXE / MSI" Style="{StaticResource PrimaryButton}" Click="ImportApplicationButton_Click" Margin="0,0,12,8" />
                                <Button Content="Refresh" Style="{StaticResource GlowButton}" Click="RefreshInstallButton_Click" Margin="0,0,0,8" />
                            </WrapPanel>
                            <TextBlock x:Name="SelectedInstallerText" Text="Choose an approved package or select an installer to approve." FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,6" />
                            <TextBlock x:Name="InstallerDetectionText" Text="MSI details and supported EXE settings are detected automatically." Style="{StaticResource Caption}" TextWrapping="Wrap" />
                            <Expander x:Name="ApplicationInstallerExpander" Header="ADVANCED OPTIONS — OPTIONAL" Foreground="{StaticResource BrushWhiteText}" IsExpanded="False" Margin="0,4,0,10">
                                <StackPanel Margin="0,12,0,0">
                                    <TextBlock Text="Leave these fields blank to use detected settings. For an unfamiliar EXE, supply its documented silent arguments. You can optionally specify the installed name/version for stricter verification." TextWrapping="Wrap" Margin="0,0,0,10" />
                                    <WrapPanel>
                                        <StackPanel Margin="0,0,12,8">
                                            <TextBlock Text="APPLICATION LABEL (optional)" />
                                            <TextBox x:Name="ApplicationNameBox" Width="230" MaxLength="200" TextChanged="InstallerOptions_TextChanged" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,12,8">
                                            <TextBlock Text="INSTALLED NAME (optional)" />
                                            <TextBox x:Name="InstalledDisplayNameBox" Width="250" MaxLength="200" TextChanged="InstallerOptions_TextChanged" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,8">
                                            <TextBlock Text="VERSION (optional)" />
                                            <TextBox x:Name="InstalledVersionBox" Width="130" MaxLength="200" TextChanged="InstallerOptions_TextChanged" />
                                        </StackPanel>
                                    </WrapPanel>
                                    <TextBlock Text="SILENT ARGUMENTS / MSI PROPERTIES (optional override)" TextWrapping="Wrap" />
                                    <TextBox x:Name="InstallerArgumentsBox" MaxLength="4000" Margin="0,5,0,10" TextChanged="InstallerOptions_TextChanged" />
                                    <TextBlock Text="EXPECTED SHA-256 (optional vendor checksum)" />
                                    <TextBox x:Name="InstallerShaBox" MaxLength="64" FontFamily="Consolas" Margin="0,5,0,10" TextChanged="InstallerOptions_TextChanged" />
                                    <TextBlock x:Name="InstallerAdvancedText" Text="Select an installer first. L&amp;T Admin verifies the installed application before reporting success." TextWrapping="Wrap" />
                                </StackPanel>
                            </Expander>
                            <TextBlock x:Name="ApprovedPackageText" TextWrapping="Wrap" Margin="0,8" />
                            <WrapPanel>
                                <Button x:Name="InstallPackageButton" Content="Install on selected PCs" Style="{StaticResource PrimaryButton}" Click="InstallPackageButton_Click" />
                            </WrapPanel>
                            <TextBlock x:Name="InstallStatusText" Text="Choose an installer and an ONLINE installer service." TextWrapping="Wrap" Margin="0,16,0,8" />
                            <TextBlock x:Name="InstallStageText" Text="No batch selected" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <ProgressBar x:Name="InstallProgress" Height="6" Minimum="0" Maximum="100" Margin="0,0,0,12" />
                            <StackPanel Margin="0,8,0,16">
                                <TextBlock Text="Batch results" Style="{StaticResource SectionTitle}" />
                                <WrapPanel Margin="0,8">
                                    <ComboBox x:Name="BatchHistoryCombo" Width="420" DisplayMemberPath="Display" SelectedValuePath="Id" SelectionChanged="BatchHistory_Changed" Margin="0,0,10,8" />
                                    <Button x:Name="RetryFailedButton" Content="Retry failed PCs" Click="RetryFailedInstallations_Click" Style="{StaticResource GlowButton}" Margin="0,0,0,8" IsEnabled="False" />
                                </WrapPanel>
                                <TextBlock Text="Retry applies to confirmed failures in the selected batch. NeedsReview requires checking the PC first." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,8" />
