                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="110" MinWidth="95">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="ToolTip" Value="{Binding StatusText}" />
                                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                                        <Setter Property="VerticalAlignment" Value="Center" />
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="2*" MinWidth="220">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="ToolTip" Value="{Binding Details}" />
                                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                                        <Setter Property="VerticalAlignment" Value="Center" />
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="Job ID" Binding="{Binding Id}" Width="240" MinWidth="95">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="ToolTip" Value="{Binding Id}" />
                                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                                        <Setter Property="VerticalAlignment" Value="Center" />
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Expander>
                </StackPanel>
                <Grid x:Name="MessagingPage" Visibility="Collapsed" MinHeight="560">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource GlassCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Text transmission" Style="{StaticResource SectionTitle}" />
                            <TextBlock Grid.Row="1" Text="RECIPIENT" Style="{StaticResource SmallLabel}" Margin="0,22,0,6" />
                            <ComboBox Grid.Row="2" x:Name="MessageTargetCombo" />
                            <TextBox Grid.Row="3" x:Name="MessageTextBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,18,0,16" FontSize="15" MinHeight="160" Height="180" />
                            <Button Grid.Row="4" Content="SEND ENCRYPTED CONTROL MESSAGE" Style="{StaticResource PrimaryButton}" Height="48" Click="SendTextButton_Click" />
                        </Grid>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource GlassCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Image transmission" Style="{StaticResource SectionTitle}" />
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,18,0,12">
                                <Button Content="SELECT IMAGE" Style="{StaticResource GlowButton}" Click="SelectMessageImageButton_Click" />
                                <TextBlock x:Name="SelectedImageNameText" Text="No file selected" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{StaticResource BrushMuted}" />
                            </StackPanel>
                            <Border Grid.Row="2" CornerRadius="14" Background="#F4F8FC" BorderBrush="#DCE6F1" BorderThickness="1">
                                <Image x:Name="MessageImagePreview" Stretch="Uniform" Margin="10" />
                            </Border>
                            <TextBox Grid.Row="3" x:Name="ImageCaptionTextBox" Margin="0,12,0,12" Height="44" VerticalContentAlignment="Center" />
                            <Button Grid.Row="4" Content="UPLOAD + SEND IMAGE" Style="{StaticResource PrimaryButton}" Height="48" Click="SendImageButton_Click" />
                        </Grid>
                    </Border>
                </Grid>
                <Grid x:Name="GroupsPage" Visibility="Collapsed" MinHeight="560">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.8*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="1.2*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource GlassCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Group library" Style="{StaticResource SectionTitle}" />
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,18,0,14">
                                <TextBox x:Name="NewGroupNameBox" Width="230" />
                                <Button Content="CREATE" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Click="CreateGroupButton_Click" />
                            </StackPanel>
                            <ListBox Grid.Row="2" x:Name="GroupsListBox" Background="#FFFFFF" Foreground="{StaticResource BrushWhiteText}" BorderBrush="#DAE4EF" SelectionChanged="GroupsListBox_SelectionChanged" />
                            <Button Grid.Row="3" Content="DELETE SELECTED GROUP" Style="{StaticResource DangerButton}" Margin="0,14,0,0" Click="DeleteGroupButton_Click" />
                        </Grid>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource GlassCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Membership matrix" Style="{StaticResource SectionTitle}" />
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,18,0,14">
                                <ComboBox x:Name="GroupClientCombo" Width="280" />
                                <Button Content="ADD CLIENT" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Click="AddGroupMemberButton_Click" />
                            </StackPanel>
                            <ListBox Grid.Row="2" x:Name="GroupMembersListBox" Background="#FFFFFF" Foreground="{StaticResource BrushWhiteText}" BorderBrush="#DAE4EF" />
                            <Button Grid.Row="3" Content="REMOVE SELECTED CLIENT" Style="{StaticResource GlowButton}" Margin="0,14,0,0" Click="RemoveGroupMemberButton_Click" />
                        </Grid>
                    </Border>
                </Grid>
                <Grid x:Name="SchedulesPage" Visibility="Collapsed" MinHeight="560">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="240" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource GlassCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Create policy" Style="{StaticResource SectionTitle}" />
                            <Grid Grid.Row="1" Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.3*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="150" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ScheduleNameBox" Grid.Column="0" />
                                <ComboBox x:Name="ScheduleTargetCombo" Grid.Column="2" />
                                <ComboBox x:Name="ScheduleActionCombo" Grid.Column="4" SelectionChanged="ScheduleActionCombo_SelectionChanged" />
                                <TextBox x:Name="ScheduleTimeBox" Grid.Column="6" Text="20:00" HorizontalContentAlignment="Center" />
                            </Grid>
                            <Grid Grid.Row="2" Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox x:Name="DayMon" Content="Mon" IsChecked="True" Margin="0,0,8,0" />
                                    <CheckBox x:Name="DayTue" Content="Tue" IsChecked="True" Margin="0,0,8,0" />
                                    <CheckBox x:Name="DayWed" Content="Wed" IsChecked="True" Margin="0,0,8,0" />
                                    <CheckBox x:Name="DayThu" Content="Thu" IsChecked="True" Margin="0,0,8,0" />
                                    <CheckBox x:Name="DayFri" Content="Fri" IsChecked="True" Margin="0,0,8,0" />
                                    <CheckBox x:Name="DaySat" Content="Sat" Margin="0,0,8,0" />
                                    <CheckBox x:Name="DaySun" Content="Sun" />
                                </StackPanel>
                                <TextBox Grid.Column="2" x:Name="ScheduleMessageBox" Height="42" VerticalContentAlignment="Center" />
                                <StackPanel Grid.Column="4" Orientation="Horizontal">
                                    <CheckBox x:Name="ScheduleEnabledCheck" Content="Enabled" IsChecked="True" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <Button Content="ADD POLICY" Style="{StaticResource PrimaryButton}" Click="AddScheduleButton_Click" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                    <Border Grid.Row="2" Style="{StaticResource GlassCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Policy timeline" Style="{StaticResource SectionTitle}" />
                            <DataGrid Grid.Row="1" x:Name="SchedulesGrid" Margin="0,16,0,0" IsReadOnly="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" CanUserResizeColumns="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="1.4*" MinWidth="95">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="ToolTip" Value="{Binding Name}" />
                                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Target" Binding="{Binding TargetText}" Width="1.4*" MinWidth="95">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="ToolTip" Value="{Binding TargetText}" />
                                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Action" Binding="{Binding ActionText}" Width="*" MinWidth="95">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="ToolTip" Value="{Binding ActionText}" />
                                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="90" MinWidth="95">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="ToolTip" Value="{Binding Time}" />
                                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Days" Binding="{Binding DaysText}" Width="1.3*" MinWidth="95">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="ToolTip" Value="{Binding DaysText}" />
                                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Enabled" Binding="{Binding EnabledText}" Width="90" MinWidth="95">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="ToolTip" Value="{Binding EnabledText}" />
                                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Last Run" Binding="{Binding LastRunText}" Width="1.4*" MinWidth="95">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="ToolTip" Value="{Binding LastRunText}" />
                                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                                <Button Content="ENABLE / DISABLE" Style="{StaticResource GlowButton}" Click="ToggleScheduleButton_Click" />
                                <Button Content="DELETE" Style="{StaticResource DangerButton}" Margin="10,0,0,0" Click="DeleteScheduleButton_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>