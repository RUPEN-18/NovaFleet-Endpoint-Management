<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Version>0.5.4</Version>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>AutoShutdown.SystemA</AssemblyName>
    <RootNamespace>AutoShutdown.Admin</RootNamespace>
    <WarningsAsErrors>$(WarningsAsErrors);ASP0016</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\lt-logo.png"/>
    <Compile Include="..\AutoShutdown.Client\Services\IdleMonitor.cs" Link="Infrastructure\IdleMonitor.cs" />
    <Compile Include="..\AutoShutdown.Client\Services\SleepGuard.cs" Link="Infrastructure\SleepGuard.cs" />
    <ProjectReference Include="..\AutoShutdown.Shared\AutoShutdown.Shared.csproj" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <None Update="appsettings.example.json">
      <TargetPath>appsettings.json</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
