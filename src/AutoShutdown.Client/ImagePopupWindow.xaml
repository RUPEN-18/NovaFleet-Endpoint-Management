<Window x:Class="AutoShutdown.Client.ImagePopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Admin Image" Width="920" Height="760" WindowStartupLocation="CenterScreen" Topmost="True" Background="{StaticResource WindowGradient}">
    <Border Margin="18" Style="{StaticResource GlassCard}">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock x:Name="TitleText" Text="ADMIN IMAGE" Style="{StaticResource SectionTitle}" Foreground="{StaticResource BrushCyan}"/>
            <Border Grid.Row="1" CornerRadius="14" Background="#D9050A10" BorderBrush="#385776" BorderThickness="1" Margin="0,16,0,14"><Image x:Name="PopupImage" Stretch="Uniform" Margin="10"/></Border>
            <TextBlock Grid.Row="2" x:Name="CaptionText" TextWrapping="Wrap" TextAlignment="Center" FontSize="16" Foreground="{StaticResource BrushWhiteText}" Margin="20,0,20,14"/>
            <Button Grid.Row="3" Content="ACKNOWLEDGE" Style="{StaticResource PrimaryButton}" Height="46" Click="CloseButton_Click"/>
        </Grid>
    </Border>
</Window>
