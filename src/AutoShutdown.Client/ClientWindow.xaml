<Window x:Class="AutoShutdown.Client.ClientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="L&amp;T Client"
        Width="1040"
        Height="790"
        MinWidth="900"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowGradient}"
        Foreground="{StaticResource BrushWhiteText}"
        TextElement.Foreground="{StaticResource BrushWhiteText}">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- =========================================================
                 HEADER
                 ========================================================= -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="L&amp;T CLIENT"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="{StaticResource BrushWhiteText}"/>
                    <TextBlock x:Name="MachineNameText"
                               Text="CLIENT"
                               Margin="1,7,0,0"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource BrushCyan}"/>
                </StackPanel>

                <Border Grid.Column="1"
                        VerticalAlignment="Center"
                        Padding="17,10"
                        CornerRadius="16"
                        Background="#2415283F"
                        BorderBrush="#6655D9FF"
                        BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect Color="#3055D9FF"
                                          BlurRadius="18"
                                          ShadowDepth="0"
                                          Opacity="0.55"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="ConnectionDot"
                                 Width="10"
                                 Height="10"
                                 Fill="{StaticResource BrushWarning}"
                                 Margin="0,4,10,0"/>
                        <TextBlock x:Name="ConnectionText"
                                   Text="CONNECTING"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushWhiteText}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- =========================================================
                 TIME METRICS
                 ========================================================= -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Style="{StaticResource GlassCard}"
                        MinHeight="170"
                        Padding="24">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <Border Width="4"
                                    Height="18"
                                    CornerRadius="2"
                                    Background="{StaticResource BrushPurple}"
                                    Margin="0,0,10,0"/>
                            <TextBlock Text="CURRENT IDLE"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushMuted}"/>
                        </StackPanel>

                        <TextBlock x:Name="IdleTimeText"
                                   Grid.Row="1"
                                   Text="00:00:00"
                                   FontSize="46"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Margin="0,16,0,0"
                                   Foreground="{StaticResource BrushWhiteText}"/>

                        <TextBlock Grid.Row="2"
                                   Text="Keyboard and mouse inactivity"
                                   Margin="0,14,0,0"
                                   FontSize="12"
                                   Foreground="{StaticResource BrushMuted}"/>
                    </Grid>
                </Border>

                <Border Grid.Column="2"
                        Style="{StaticResource GlassCard}"
                        MinHeight="170"
                        Padding="24">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <Border Width="4"
                                    Height="18"
                                    CornerRadius="2"
                                    Background="{StaticResource BrushCyan}"
                                    Margin="0,0,10,0"/>
                            <TextBlock Text="AUTO SHUTDOWN IN"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushMuted}"/>
                        </StackPanel>

                        <TextBlock x:Name="RemainingTimeText"
                                   Grid.Row="1"
                                   Text="00:00:00"
                                   FontSize="46"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Margin="0,16,0,0"
                                   Foreground="{StaticResource BrushCyan}">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#6655D9FF"
                                                  BlurRadius="16"
                                                  ShadowDepth="0"
                                                  Opacity="0.65"/>
                            </TextBlock.Effect>
                        </TextBlock>

                        <TextBlock Grid.Row="2"
                                   Text="Time remaining under the active policy"
                                   Margin="0,14,0,0"
                                   FontSize="12"
                                   Foreground="{StaticResource BrushMuted}"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- =========================================================
                 LIVE POLICY
                 ========================================================= -->
            <Border Grid.Row="4"
                    Style="{StaticResource GlassCard}"
                    Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <Border Width="4"
                                Height="24"
                                CornerRadius="2"
                                Background="{StaticResource BrushBlue}"
                                Margin="0,0,10,0"/>
                        <TextBlock Text="LIVE POLICY"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource BrushWhiteText}"/>
                    </StackPanel>

                    <UniformGrid Grid.Row="2"
                                 Columns="2">

                        <Border Margin="0,0,10,10"
                                Padding="18"
                                CornerRadius="14"
                                Background="#40132235"
                                BorderBrush="#354D6B"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="MONITORING"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushMuted}"/>
                                <TextBlock x:Name="MonitoringText"
                                           Text="ACTIVE"
                                           Margin="0,8,0,0"
                                           FontSize="21"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource BrushSuccess}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Margin="10,0,0,10"
                                Padding="18"
                                CornerRadius="14"
                                Background="#40132235"
                                BorderBrush="#354D6B"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="IDLE SCREEN AFTER"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushMuted}"/>
                                <TextBlock x:Name="IdleDelayText"
                                           Text="10 min"
                                           Margin="0,8,0,0"
                                           FontSize="21"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource BrushWhiteText}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,10,10,0"
                                Padding="18"
                                CornerRadius="14"
                                Background="#40132235"
                                BorderBrush="#354D6B"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="IDLE DISPLAY"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushMuted}"/>
                                <TextBlock x:Name="IdleDisplayText"
                                           Text="ON"
                                           Margin="0,8,0,0"
                                           FontSize="21"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource BrushCyan}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Margin="10,10,0,0"
                                Padding="18"
                                CornerRadius="14"
                                Background="#40132235"
                                BorderBrush="#354D6B"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="SHUTDOWN / WARNING"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushMuted}"/>
                                <TextBlock x:Name="ShutdownPolicyText"
                                           Text="3 hr / 60 sec"
                                           Margin="0,8,0,0"
                                           FontSize="21"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource BrushWhiteText}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </Grid>
            </Border>

            <!-- =========================================================
                 CLIENT CONTROL
                 ========================================================= -->
            <Border Grid.Row="6"
                    Style="{StaticResource GlassCard}"
                    Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <Border Width="4"
                                Height="24"
                                CornerRadius="2"
                                Background="{StaticResource BrushPurple}"
                                Margin="0,0,10,0"/>
                        <TextBlock Text="CLIENT CONTROL"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource BrushWhiteText}"/>
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    VerticalAlignment="Center">
                            <CheckBox x:Name="StartupCheck"
                                      Content="Start Client automatically with Windows"
                                      Checked="StartupCheck_Changed"
                                      Unchecked="StartupCheck_Changed"
                                      Foreground="{StaticResource BrushWhiteText}"
                                      FontSize="14"
                                      FontWeight="SemiBold"/>

                            <TextBlock x:Name="StatusDetailText"
                                       Text="Waiting for Admin…"
                                       Margin="0,12,0,0"
                                       FontSize="13"
                                       Foreground="{StaticResource BrushMuted}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <Button Content="CANCEL SHUTDOWN"
                                    Width="190"
                                    Height="46"
                                    Margin="0,0,12,0"
                                    Style="{StaticResource GlowButton}"
                                    Click="CancelShutdownButton_Click"/>

                            <Button Content="MINIMIZE"
                                    Width="110"
                                    Height="46"
                                    Style="{StaticResource DangerButton}"
                                    Click="ExitButton_Click"/>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="4"
                            CornerRadius="12"
                            Padding="13"
                            Background="#29131F31"
                            BorderBrush="#304561"
                            BorderThickness="1">
                        <StackPanel>
                        <TextBlock x:Name="DeploymentStatusText" Text="INSTALLATIONS: loading..." TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <TextBlock Text="Client receives application installations and shutdown commands from Admin, and applies the keyboard/mouse inactivity policy."
                                   FontSize="12"
                                   Foreground="{StaticResource BrushMuted}"
                                   TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

        </Grid>
    </ScrollViewer>
</Window>
