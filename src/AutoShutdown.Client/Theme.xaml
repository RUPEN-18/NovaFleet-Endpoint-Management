<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="Obsidian">#070B12</Color>
    <Color x:Key="DeepNavy">#0B1220</Color>
    <Color x:Key="Panel">#111B2C</Color>
    <Color x:Key="Panel2">#152338</Color>
    <Color x:Key="Cyan">#55D9FF</Color>
    <Color x:Key="Blue">#4C8DFF</Color>
    <Color x:Key="Purple">#8D6BFF</Color>
    <Color x:Key="WhiteText">#F5F9FF</Color>
    <Color x:Key="Muted">#94A7BF</Color>
    <Color x:Key="Danger">#FF5D73</Color>
    <Color x:Key="Warning">#FFB454</Color>
    <Color x:Key="Success">#41E3A5</Color>
    <Color x:Key="Border">#2A4362</Color>

    <SolidColorBrush x:Key="BrushObsidian" Color="{StaticResource Obsidian}"/>
    <SolidColorBrush x:Key="BrushDeepNavy" Color="{StaticResource DeepNavy}"/>
    <SolidColorBrush x:Key="BrushPanel" Color="{StaticResource Panel}"/>
    <SolidColorBrush x:Key="BrushPanel2" Color="{StaticResource Panel2}"/>
    <SolidColorBrush x:Key="BrushCyan" Color="{StaticResource Cyan}"/>
    <SolidColorBrush x:Key="BrushBlue" Color="{StaticResource Blue}"/>
    <SolidColorBrush x:Key="BrushPurple" Color="{StaticResource Purple}"/>
    <SolidColorBrush x:Key="BrushWhiteText" Color="{StaticResource WhiteText}"/>
    <SolidColorBrush x:Key="BrushMuted" Color="{StaticResource Muted}"/>
    <SolidColorBrush x:Key="BrushDanger" Color="{StaticResource Danger}"/>
    <SolidColorBrush x:Key="BrushWarning" Color="{StaticResource Warning}"/>
    <SolidColorBrush x:Key="BrushSuccess" Color="{StaticResource Success}"/>
    <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource Border}"/>

    <LinearGradientBrush x:Key="WindowGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#070B12" Offset="0"/>
        <GradientStop Color="#0B1424" Offset="0.45"/>
        <GradientStop Color="#0D1020" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="NeonGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#55D9FF" Offset="0"/>
        <GradientStop Color="#4C8DFF" Offset="0.55"/>
        <GradientStop Color="#8D6BFF" Offset="1"/>
    </LinearGradientBrush>

    <Style TargetType="Window">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="Foreground" Value="{StaticResource BrushWhiteText}"/>
        <Setter Property="Background" Value="{StaticResource WindowGradient}"/>
    </Style>

    <Style x:Key="GlassCard" TargetType="Border">
        <Setter Property="CornerRadius" Value="18"/>
        <Setter Property="BorderBrush" Value="#4A2F567B"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="#B3131E30"/>
        <Setter Property="Padding" Value="18"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#22000000" BlurRadius="28" ShadowDepth="8" Opacity="0.75"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GlowButton" TargetType="Button">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="#1C2940"/>
        <Setter Property="BorderBrush" Value="#3D5D7E"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="16,10"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <Border x:Name="Glow" CornerRadius="10" BorderBrush="#7755D9FF" BorderThickness="1" Opacity="0"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#243B5A"/>
                            <Setter TargetName="Glow" Property="Opacity" Value="1"/>
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#55D9FF" BlurRadius="20" ShadowDepth="0" Opacity="0.42"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#2C4A70"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource GlowButton}">
        <Setter Property="Background" Value="#334C8DFF"/>
        <Setter Property="BorderBrush" Value="#AA55D9FF"/>
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource GlowButton}">
        <Setter Property="Background" Value="#38FF5D73"/>
        <Setter Property="BorderBrush" Value="#99FF5D73"/>
    </Style>

    <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource GlowButton}">
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="18,12"/>
        <Setter Property="Margin" Value="8,4"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource BrushWhiteText}"/>
        <Setter Property="Background" Value="#BB101B2D"/>
        <Setter Property="BorderBrush" Value="#425B79"/>
        <Setter Property="CaretBrush" Value="{StaticResource BrushCyan}"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="#18263B"/>
        <Setter Property="BorderBrush" Value="#425B79"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource BrushWhiteText}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Margin" Value="0,4"/>
    </Style>

    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="#AA0C1422"/>
        <Setter Property="Foreground" Value="{StaticResource BrushWhiteText}"/>
        <Setter Property="BorderBrush" Value="#2E4A68"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="#223A55"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="RowBackground" Value="#8A101A2B"/>
        <Setter Property="AlternatingRowBackground" Value="#8A142036"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserDeleteRows" Value="False"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="SelectionUnit" Value="FullRow"/>
        <Setter Property="RowHeight" Value="38"/>
        <Setter Property="ColumnHeaderHeight" Value="40"/>
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#17253A"/>
        <Setter Property="Foreground" Value="{StaticResource BrushCyan}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="BorderBrush" Value="#2E4A68"/>
        <Setter Property="Padding" Value="10,0"/>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="Foreground" Value="{StaticResource BrushWhiteText}"/>
    </Style>

    <Style x:Key="MetricValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="34"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource BrushWhiteText}"/>
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource BrushWhiteText}"/>
    </Style>

    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource BrushMuted}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
</ResourceDictionary>
