<Window x:Class="AutoShutdown.Client.IdleOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Maximized"
        ShowInTaskbar="False"
        Topmost="True"
        Background="#05080D"
        AllowsTransparency="False">
    <Grid Background="#05080D">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="260"/></Grid.RowDefinitions>
        <Image x:Name="ArtworkImage" Grid.Row="0" Stretch="Uniform" Margin="30,20,30,0"/>
        <Grid Grid.Row="1">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#00101828" Offset="0"/>
                    <GradientStop Color="#B20B1B2D" Offset="0.28"/>
                    <GradientStop Color="#E3133454" Offset="0.72"/>
                    <GradientStop Color="#F0186091" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="1200">
                <TextBlock x:Name="IdleMessageText" Text="This computer is currently inactive." TextAlignment="Center" TextWrapping="Wrap" FontSize="34" FontWeight="SemiBold" Foreground="#F6FAFF"/>
                <TextBlock x:Name="CountdownText" Text="Automatic shutdown in 02:59:54" TextAlignment="Center" FontSize="24" FontWeight="Bold" Foreground="#65DFFF" Margin="0,18,0,0"/>
                <TextBlock Text="Move the mouse or press any key to continue" TextAlignment="Center" FontSize="14" Foreground="#BDD0E4" Margin="0,18,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
